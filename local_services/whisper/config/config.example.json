{
  "server_exe": "../../build/whisper/bin/Release/whisper-server.exe",
  "ffmpeg_exe": "ffmpeg",
  "models_dir": "../../models/whisper",
  "default_model": "ggml-large-v3-turbo-q5_0.bin",
